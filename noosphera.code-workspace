{
    "folders": [
        {
            "name": "0-CORE-ROOT",
            "path": "."
        },
        {
            "name": "1-SHARED",
            "path": "agents/shared"
        },
        {
            "name": "2-NISABA (Orchestration)",
            "path": "agents/Nisaba",
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder:0-CORE-ROOT}/Venvs/nisaba/bin/python"
            }
        },
        {
            "name": "3-THOTH (Text)",
            "path": "agents/Thoth",
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder:0-CORE-ROOT}/Venvs/thoth/bin/python"
            }
        },
        {
            "name": "4-EUTERPE (Audio)",
            "path": "agents/Euterpe"
        },
        {
            "name": "5-HERMES (Semantics)",
            "path": "agents/Hermes"
        },
        {
            "name": "6-JANUS (History)",
            "path": "agents/Janus"
        },
        {
            "name": "7-ERIS (Audit)",
            "path": "agents/Eris"
        },
        {
            "name": "8-TOOL-GLYPHAR (OpenCV/Tesseract)",
            "path": "tools/Glyphar",
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder:0-CORE-ROOT}/Venvs/glyphar/bin/python"
            }
        },
        {
            "name": "9-TOOL-LYRA (pyannote/Whisper)",
            "path": "tools/Lyra"
        },
        {
            "name": "10-TOOL-NOMOS (spaCy/LiLT)",
            "path": "tools/Nomos"
        },
        {
            "name": "11-INFRA-DOCKER (Prefect/PostgreSQL/Cypher)",
            "path": "docker"
        },
        {
            "name": "12-FLOWS",
            "path": "flows"
        }
    ],
    "settings": {
        // --- IMPORT RESOLUTION (PYTHONPATH) ---
        "python.analysis.extraPaths": [
            "./agents/shared",
            "./agents/Nisaba",
            "./agents/Thoth",
            "./agents/Euterpe",
            "./agents/Hermes",
            "./agents/Janus",
            "./agents/Eris",
            "./tools/Glyphar",
            "./tools/Lyra",
            "./tools/Nomos"
        ],
        "python.envFile": "${workspaceFolder:0-CORE-ROOT}/.env",
        "python.terminal.useEnvFile": true,
        "python.analysis.autoImportCompletions": true,
        "editor.formatOnSave": true,
        "python.formatting.provider": "black",
        "python.analysis.typeCheckingMode": "basic",
        "files.exclude": {
            "**/.git": true,
            "**/__pycache__": true,
            "Venvs": true
        }
    }
}
