{
    // 1. Resolve a importação da pasta 'shared' e dos agentes
    "python.analysis.extraPaths": [
        "./shared",
        "./agents/Nisaba",
        "./agents/Glyphar"
    ],

    // 2. Aponta para o seu novo .env global (SST)
    "python.envFile": "${workspaceFolder}/.env",

    // 3. Garante que o terminal sempre carregue o .env global
    "python.terminal.useEnvFile": true,

    // 4. Configurações de Formatação (Padrão para todos os agentes)
    "editor.formatOnSave": true,
    "python.formatting.provider": "black",
    "python.analysis.autoImportCompletions": true,

    // 5. Organização de janelas (Esconde pastas irrelevantes)
    "files.exclude": {
        "**/.git": true,
        "**/.pyc": true,
        "**/__pycache__": true,
        "**/Venvs": true
    }
}
