# Base image using the latest stable PostgreSQL 18 on Debian Bookworm
FROM postgres:18-bookworm

# Metadata and maintainer information
LABEL maintainer="yuri@noosphera"
LABEL version="1.0"
LABEL description="Optimized PostgreSQL 18 with pgvector and pg_search (ParadeDB/BM25)"

# Environment variables for build optimization
ENV DEBIAN_FRONTEND=noninteractive

/**
 * 1. Layer Consolidation & Security
 * - Installs curl/gnupg for repository setup.
 * - Keeps ca-certificates to ensure secure outbound TLS connections (essential for APIs/Extensions).
 * - Cleans up build-only tools after installation to reduce attack surface and image size.
 */
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    ca-certificates \
    && curl -fsSL https://paradedb.com/install.sh | sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    postgresql-18-pgvector \
    postgresql-18-pg-search \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

/**
 * 2. Configuration Management
 * - Copies the tuned postgresql.conf with correct ownership.
 * - Ensures the 'postgres' user can read the config at runtime.
 */
COPY --chown=postgres:postgres config/postgresql.conf /etc/postgresql/postgresql.conf

/**
 * 3. Healthcheck
 * - Robust check using pg_isready.
 * - Targets the default 'postgres' database to avoid false negatives during startup.
 */
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD pg_isready -U "${POSTGRES_USER:-postgres}" -d postgres

# Run as non-privileged user for security
USER postgres

# Starts Postgres pointing to the custom optimized configuration file
CMD ["postgres", "-c", "config_file=/etc/postgresql/postgresql.conf"]
